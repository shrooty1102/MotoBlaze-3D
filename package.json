{
  "name": "motoblaze-3d",
  "productName": "MotoBlaze 3D",
  "version": "1.0.0",
  "description": "3D bike racing game - race against 4 rivals across 30 levels",
  "author": "MotoBlaze 3D",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "icons": "node scripts/make-icons.mjs",
    "electron": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --publish never",
    "android:sync": "vite build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.motoblaze3d.game",
    "productName": "MotoBlaze 3D",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MotoBlaze 3D"
    }
  }
}
